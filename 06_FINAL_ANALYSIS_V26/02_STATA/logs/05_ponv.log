. * Calculate log RR and SE
. gen p_i = events_i / n_i

. gen p_c = events_c / n_c

. gen rr = p_i / p_c

. gen lnrr = ln(rr)

. gen se_lnrr = sqrt((1/events_i - 1/n_i) + (1/events_c - 1/n_c))

. 
