 22.     local k_lo = r(ci_lb)
 23.     local k_hi = r(ci_ub)
 24.     local k_p  = r(p)
 25.     local se_kh = (r(ci_ub) - r(theta)) / invttail(r(df), 0.025)
 26. 
.     local dfbetas = (`theta_full' - `md') / `se_kh'
