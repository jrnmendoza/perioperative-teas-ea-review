. * =============================================================================
. * Helper: fit one stratum, or record it as a single study
. * =============================================================================
. capture program drop fitstratum

. program define fitstratum
  1.     args aid mod comp
  2.     quietly count
  3.     local k = r(N)
  4.     if `k' == 0 exit
  5.     di as txt _n "---------------------------------------------------------------"
  6.     di as txt "`aid' | `mod' vs `comp' | k = `k'"
  7.     di as txt "---------------------------------------------------------------"
  8.     list study, clean noobs
  9.     if `k' == 1 {
 10.         di as txt "  Single study: not pooled."
 11.     }
 12.     else {
 13.         meta summarize, random(reml) se(kh)
 14.     }
 15. end

. 
