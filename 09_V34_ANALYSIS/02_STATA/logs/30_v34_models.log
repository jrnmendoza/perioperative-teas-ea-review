>     "pain_vas_24h_TEAS_Sham MD Mean_difference_VAS" ///
>     "ponv_24h_TEAS_Sham logRR Log_risk_ratio" {
  2. 
.     local mid    : word 1 of `spec'
  3.     local meas   : word 2 of `spec'
  4.     local lab    : word 3 of `spec'
  5.     fitmodel "09_V34_ANALYSIS/01_DATA/`mid'.csv" "`mid'" "`meas'" "`lab'"
  6.     post `R' ("`mid'") ("`meas'") ($M_k) ($M_est) ($M_lo) ($M_hi) ($M_p) ///
>              ($M_tau2) ($M_i2) ("$M_model") ("NEW")
  7. }
