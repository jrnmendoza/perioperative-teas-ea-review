. capture program drop fmtnum

. program define fmtnum, rclass
  1.     * Trimmed number with a leading zero ("0.034", "-0.9").
.     args x fmt
  2.     local s = strtrim(string(`x', "`fmt'"))
  3.     if substr("`s'", 1, 1) == "." local s "0`s'"
  4.     if substr("`s'", 1, 2) == "-." local s = "-0" + substr("`s'", 2, .)
  5.     return local s "`s'"
  6. end

. 
. capture program drop fmtp

. program define fmtp, rclass
  1.     * "p < 0.001" or "p = 0.034" (three decimals, leading zero).
.     args x
  2.     if `x' < .001 return local s "p < 0.001"
  3.     else {
  4.         fmtnum `x' %5.3f
  5.         return local s "p = `r(s)'"
  6.     }
  7. end

. 
. capture program drop niceaxis

. program define niceaxis, rclass
  1.     * Axis range and labels for [lo, hi] (log scale when ef == 1; values then exponentiated for -eform- plots).
.     args lo hi ef
  2.     local pad = (`hi' - `lo')*.05
  3.     local lo = `lo' - `pad'
  4.     local hi = `hi' + `pad'
  5.     if "`ef'" == "1" {
  6.         * First label set with 2-8 labels that spans at least half the axis (no crowded or bunched labels).
.         foreach set in ".25 .5 .75 1 1.5 2 3" ".1 .2 .5 1 2 5 10" ".05 .1 .2 .5 1 2 5 10 20" ".01 .1 1 10 100" ".001 .
> 01 .1 1 10 100 1000" {
  7.             local labs ""
  8.             local n = 0
  9.             local cmin = .
 10.             local cmax = 0
 11.             foreach c of local set {
 12.                 if ln(`c') >= `lo' & ln(`c') <= `hi' {
 13.                     fmtnum `c' %9.0g
 14.                     local labs `"`labs' `c' "`r(s)'""'
 15.                     local ++n
 16.                     local cmin = min(`cmin', `c')
 17.                     local cmax = max(`cmax', `c')
 18.                 }
 19.             }
 20.             if `n' <= 8 & `n' >= 2 & ln(`cmax') - ln(`cmin') >= .5*(`hi' - `lo') continue, break
 21.         }
 22.         return local range = "`=exp(`lo')' `=exp(`hi')'"
 23.         return local labels `"`labs'"'
 24.     }
 25.     else {
 26.         local raw = (`hi' - `lo')/5
 27.         local p = 10^floor(log10(`raw'))
 28.         local step ""
 29.         foreach m in 1 2 2.5 5 10 {
 30.             if "`step'" == "" & `m'*`p' >= `raw' local step = `m'*`p'
 31.         }
 32.         local a = floor(`lo'/`step')*`step'
 33.         local b = ceil(`hi'/`step')*`step'
 34.         return local range "`a' `b'"
 35.         return local labels "`a'(`step')`b'"
 36.     }
 37. end

