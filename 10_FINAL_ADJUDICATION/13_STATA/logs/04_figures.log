. import delimited using "$STATA/input/figure_specs.csv", clear varnames(1) bindquote(strict) stringcols(_all)
(encoding automatically selected: UTF-8)
(11 vars, 27 obs)

. local nf = _N

. foreach v in figure_id kind analysis_set model_id title subtitle xtitle eform threshold {
  2.     forvalues j = 1/`nf' {
  3.         local `v'`j' = `v'[`j']
  4.     }
  5. }

. tempname reg sst

. postfile `reg' str60 figure_id str8 kind str16 analysis_set str80 model_id int k long N double(theta ci_lb ci_ub tau2 
> I2 pi_lb pi_ub) ///
>     using "$STATA/work/figure_values.dta", replace

. postfile `sst' str80 model_id int k str20 test double(stat p) using "$STATA/work/small_study.dta", replace

. local opt se(khartung, truncated) tolerance(1e-14) nrtolerance(1e-14) iterate(1000)

. forvalues j = 1/`nf' {
  2.     use "$STATA/work/inputs_es.dta", clear
  3.     keep if analysis_set == "`analysis_set`j''" & model_id == "`model_id`j''"
  4.     local k = _N
  5.     assert `k' >= 1
  6.     quietly summarize n_i
  7.     local N = r(sum)
  8.     quietly summarize n_c
  9.     local N = `N' + r(sum)
 10.     local isrr = "`eform`j''" == "1"
 11.     local ef = cond(`isrr', "eform", "")
 12.     local xl = cond("`threshold`j''" != "", "xline(`threshold`j'', lpattern(shortdash) lcolor(orange) lwidth(medthi
> ck))", "")
 13.     local esname = cond(`isrr', "Risk ratio", "Mean difference")
 14.     meta set s_yi s_se, studylabel(study) random(reml)
 15.     local th = s_yi[1]
 16.     local lb = s_yi[1] - invnormal(.975)*s_se[1]
 17.     local ub = s_yi[1] + invnormal(.975)*s_se[1]
 18.     local t2 = 0
 19.     local i2 = .
 20.     local pl = .
 21.     local pu = .
 22.     if `k' >= 2 {
 23.         quietly meta summarize, `opt'
 24.         local th = r(theta)
 25.         local lb = r(ci_lb)
 26.         local ub = r(ci_ub)
 27.         local t2 = r(tau2)
 28.         local i2 = r(I2)
 29.         local q = r(Q)
 30.         local qdf = r(df_Q)
 31.         local qp = r(p_Q)
 32.         if `k' >= 5 {
 33.             local pl = r(theta) - invttail(`k'-1, .025)*sqrt(r(tau2) + r(se)^2)
 34.             local pu = r(theta) + invttail(`k'-1, .025)*sqrt(r(tau2) + r(se)^2)
 35.         }
 36.     }
 37.     post `reg' ("`figure_id`j''") ("`kind`j''") ("`analysis_set`j''") ("`model_id`j''") (`k') (`N') (`th') (`lb') (
> `ub') (`t2') (`i2') (`pl') (`pu')
 38.     * Axis extent (log scale for risk ratios).
.     tempvar sl su
 39.     quietly gen double `sl' = s_yi - invnormal(.975)*s_se
 40.     quietly gen double `su' = s_yi + invnormal(.975)*s_se
 41.     quietly summarize `sl'
 42.     local xlo = min(r(min), `lb', 0)
 43.     quietly summarize `su'
 44.     local xhi = max(r(max), `ub', 0)
 45.     if `pl' < . local xlo = min(`xlo', `pl')
 46.     if `pu' < . local xhi = max(`xhi', `pu')
 47.     if "`threshold`j''" != "" {
 48.         local xlo = min(`xlo', `threshold`j'')
 49.         local xhi = max(`xhi', `threshold`j'')
 50.     }
 51.     if "`kind`j''" == "loo" {
 52.         quietly meta summarize, leaveoneout `opt'
 53.         matrix L = r(leaveoneout)
 54.         forvalues r = 1/`=rowsof(L)' {
 55.             local xlo = min(`xlo', L[`r', "ci_lb"])
 56.             local xhi = max(`xhi', L[`r', "ci_ub"])
 57.         }
 58.     }
 59.     niceaxis `xlo' `xhi' `isrr'
 60.     local axis `"xscale(range(`r(range)')) xlabel(`r(labels)')"'
 61.     * Notes: what was fitted, with the values Stata computed.
.     * Summary rows under the pooled estimate replace Stata's defaults: heterogeneity with Q and a formatted p,
.     * and the prediction interval in the canonical t(k-1) convention (Stata's own PI uses k-2). No test of theta = 0.
.     local tr = cond(`isrr', "exp", "")
 62.     fmtnum `t2' %9.3g
 63.     local t2s "`r(s)'"
 64.     local studies = cond(`k' == 1, "1 study", "`k' studies")
 65.     local PIs ""
 66.     if `pl' < . {
 67.         fmtnum `tr'(`pl') %9.2f
 68.         local a "`r(s)'"
 69.         fmtnum `tr'(`pu') %9.2f
 70.         local PIs "95% prediction interval: `a' to `r(s)'"
 71.     }
 72.     * Short lines (Stata sizes the label column to its widest text).
.     local HET ""
 73.     local HOM ""
 74.     if `k' >= 2 {
 75.         fmtp `qp'
 76.         local HET "Heterogeneity: {&tau}{superscript:2} = `t2s', I{superscript:2} = `: display %4.1f `i2''%"
 77.         local HOM "Test of homogeneity: Q(`qdf') = `: display %4.2f `q'', `r(s)'"
 78.     }
 79.     local THR ""
 80.     if "`threshold`j''" != "" local THR "Dotted line: -10 mg IV MME registered clinical-importance threshold."
 81.     if `k' == 1 local L1 "k = 1 study; N = `N' participants. Single study: estimate with normal 95% CI; not pooled.
> "
 82.     else        local L1 "k = `studies'; N = `N' participants. Random effects: REML, truncated Knapp-Hartung 95% CI
>  (t, k-1 df)`=cond(`pl' < ., "; prediction interval t, k-1 df", "")'."
 83.     local L2 "`THR'"
 84.     local summ noosigtest
 85.     if `k' == 1 local summ noohetstats noohomtest noosigtest
 86.     else if "`PIs'" == "" local summ ohetstatstext("`HET'") ohomtesttext("`HOM'") noosigtest
 87.     else local summ ohetstatstext("`HET'") ohomtesttext("`HOM'") osigtesttext("`PIs'")
 88.     local esci columnopts(_esci, supertitle("`esname'"))
 89.     local L3 "Model `model_id`j'' (`analysis_set`j''). StataNow/SE `c(stata_version)', 13_STATA/do/04_figures.do."
 90.     local ys = max(3.6, 2.4 + 0.34*`k')
 91.     local base title("`title`j''", size(medium)) subtitle("`subtitle`j''", size(small)) xtitle("`xtitle`j''") xsize
> (9) ysize(`ys') name(g, replace)
 92.     if "`kind`j''" == "funnel" {
 93.         gen double a = events_i
 94.         gen double b = n_i - events_i
 95.         gen double c = events_c
 96.         gen double dd = n_c - events_c
 97.         meta clear
 98.         meta esize a b c dd, esize(lnrratio) studylabel(study) random(reml)
 99.         quietly meta bias, harbord
100.         local hz = r(z)
101.         local hp = r(p)
102.         post `sst' ("`model_id`j''") (`k') ("Harbord") (`hz') (`hp')
103.         local F1 "k = `k' studies; contours mark two-sided p-value regions around no effect; vertical line: inverse
> -variance (common-effect) estimate."
104.         fmtp `hp'
105.         local F2 "Harbord test for small-study effects: z = `: display %5.2f `hz'', `r(s)'. Low power at k = 10; ex
> ploratory, not used for GRADE."
106.         meta funnelplot, contours(1 5 10) `base' note(`"`F1'"' `"`F2'"' `"`L3'"', size(vsmall))
107.     }
108.     else {
109.         if "`L2'" == "" local notes note(`"`L1'"' `"`L3'"', size(vsmall))
110.         else            local notes note(`"`L1'"' `"`L2'"' `"`L3'"', size(vsmall))
111.         if "`kind`j''" == "loo" {
112.             * Leave-one-out: no p-value column; the solid line is the estimate with all k studies (stated in the no
> tes).
.             fmtnum `tr'(`th') %9.2f
113.             local e0 "`r(s)'"
114.             fmtnum `tr'(`lb') %9.2f
115.             local e1 "`r(s)'"
116.             fmtnum `tr'(`ub') %9.2f
117.             local LA "Each row re-fits the random-effects model (REML, truncated Knapp-Hartung) without the named s
> tudy."
118.             local LB "Solid line: estimate with all `k' studies, `e0' [`e1', `r(s)']. `HET'; `HOM'."
119.             local LC = cond("`PIs'" == "", "", "`PIs' (t, k-1 df)")
120.             if "`THR'" != "" & "`LC'" != "" local LC "`LC'. `THR'"
121.             else if "`THR'" != "" local LC "`THR'"
122.             if "`LC'" == "" local notes note(`"`LA'"' `"`LB'"' `"`L3'"', size(vsmall))
123.             else            local notes note(`"`LA'"' `"`LB'"' `"`LC'"' `"`L3'"', size(vsmall))
124.             meta forestplot _id _plot _esci, leaveoneout `opt' nullrefline `ef' `xl' `axis' `esci' `base' `notes'
125.             preserve
126.             clear
127.             svmat double L, names(col)
128.             gen str80 model_id = "`model_id`j''"
129.             quietly ds, has(type numeric)
130.             format `r(varlist)' %21.16g
131.             export delimited using "$STATA/output/leaveoneout_`model_id`j''.csv", replace datafmt
132.             restore
133.         }
134.         else if `k' == 1 meta forestplot _id _plot _esci, nooverall `summ' nullrefline `ef' `xl' `axis' `esci' `bas
> e' `notes'
135.         else             meta forestplot _id _plot _esci _weight, `opt' `summ' nullrefline `ef' `xl' `axis' `esci' 
> `base' `notes'
136.     }
137.     graph export "$STATA/figures/`figure_id`j''.svg", replace
138.     graph export "$STATA/figures/`figure_id`j''.pdf", replace
139.     graph export "$STATA/figures/`figure_id`j''.png", replace width(2400)
140.     meta clear
141. }
