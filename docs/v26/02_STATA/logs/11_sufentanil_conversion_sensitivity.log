. 
. * ------------------------------------------------------------------------------
. * PART 1: STRICT PRIMARY (k=6) UNDER ALTERNATIVE SUFENTANIL FACTORS
. *   Only Chen 2020 is sufentanil-converted within the strict primary set.
. * ------------------------------------------------------------------------------
. foreach factor in 0.1 0.25 0.5 1.0 {
  2.     use "06_FINAL_ANALYSIS_V26/01_DATA/opioid_24h_primary.dta", clear
  3.     keep if inc_primary == 1
  4. 
.     replace mean_i_mme = mean_i * `factor' if unit == "µg sufentanil"
  5.     replace sd_i_mme   = sd_i   * `factor' if unit == "µg sufentanil"
  6.     replace mean_c_mme = mean_c * `factor' if unit == "µg sufentanil"
  7.     replace sd_c_mme   = sd_c   * `factor' if unit == "µg sufentanil"
  8.     replace md_mme = mean_i_mme - mean_c_mme if unit == "µg sufentanil"
  9.     replace se_mme = sqrt((sd_i_mme^2/n_i) + (sd_c_mme^2/n_c)) if unit == "µg sufentanil"
 10. 
.     meta set md_mme se_mme, studylabel(study_unit) eslabel("Mean Difference (mg IV MME)")
 11.     meta summarize, random(reml) se(kh)
 12. 
.     di as txt _n "Sufentanil factor = `factor' mg MME per ug | Strict primary k=6:"
 13.     di as txt "  MD = " %6.3f r(theta) "  95% KH CI [" %6.3f r(ci_lb) ", " %6.3f r(ci_ub) "]  p
>  = " %6.4f r(p) "  I2 = " %5.2f r(I2) "%"
 14. }
