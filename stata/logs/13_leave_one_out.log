. 
. forvalues i = 1/11 {
  2.     preserve
  3.     local dropped_name = canonical_name[`i']
  4.     drop if _n == `i'
  5.     qui meta summarize, random(reml) se(kh)
  6.     local md : di %6.3f r(theta)
  7.     local cil : di %6.3f r(ci_lb)
  8.     local ciu : di %6.3f r(ci_ub)
  9.     local p : di %6.4f r(p)
 10.     local i2 : di %5.2f r(I2)
 11.     local t2 : di %5.2f r(tau2)
 12.     local crosses = "No"
 13.     if `cil' <= 0 & `ciu' >= 0 {
 14.         local crosses = "YES"
 15.     }
 16.     di as res %-25s "`dropped_name'" " | " %7s "`md'" " | [" %6s "`cil'" ", " %6s "`ciu'" "] | 
> " %6s "`p'" " | " %5s "`i2'" " | " %5s "`t2'" " | " %9s "`crosses'"
 17.     restore
 18. }
