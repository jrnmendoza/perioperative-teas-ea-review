. 
. forvalues i = 1/11 {
  2.     preserve
  3.     local dropped_id : di %12.0f study_id[`i']
  4.     local dropped_id = trim("`dropped_id'")
  5.     local dropped_name = canonical_name[`i']
  6.     local dropped_author = author[`i']
  7.     local dropped_year = year[`i']
  8.     drop if _n == `i'
  9.     qui sum total_n
 10.     local rem_n = r(sum)
 11.     local rem_k = r(N)
 12. 
.     * Wald REML
.     qui meta summarize, random(reml)
 13.     local wald_md = r(theta)
 14.     local wald_se = r(se)
 15.     local wald_cil = r(ci_lb)
 16.     local wald_ciu = r(ci_ub)
 17.     local wald_p = r(p)
 18. 
.     * Knapp-Hartung REML
.     qui meta summarize, random(reml) se(kh)
 19.     local kh_md = r(theta)
 20.     local kh_se = r(se)
 21.     local kh_cil = r(ci_lb)
 22.     local kh_ciu = r(ci_ub)
 23.     local kh_p = r(p)
 24.     local i2 = r(I2)
 25.     local t2 = r(tau2)
 26. 
.     * Standardized influence DFBETAS: (overall_md - md) / se
.     local dfbetas = (`overall_md' - `kh_md') / `kh_se'
 27. 
.     * Format for display
.     local f_md : di %6.3f `kh_md'
 28.     local f_wcil : di %6.3f `wald_cil'
 29.     local f_wciu : di %6.3f `wald_ciu'
 30.     local f_wp : di %6.4f `wald_p'
 31.     local f_kcl : di %6.3f `kh_cil'
 32.     local f_kcu : di %6.3f `kh_ciu'
 33.     local f_kp : di %6.4f `kh_p'
 34.     local f_t2 : di %5.2f `t2'
 35.     local f_i2 : di %5.2f `i2'
 36.     local f_dfb : di %6.3f `dfbetas'
 37. 
.     di as res %-25s "`dropped_name'" " | " %7s "`f_md'" " | [" %6s "`f_wcil'"
>  ", " %6s "`f_wciu'" "] | " %6s "`f_wp'" " | [" %6s "`f_kcl'" ", " %6s "`f_kc
> u'" "] | " %6s "`f_kp'" " | " %5s "`f_t2'" " | " %5s "`f_i2'" " | " %6s "`f_d
> fb'"
 38. 
.     file write fh `"`dropped_id',"`dropped_name'","`dropped_author'",`dropped
> _year',`rem_k',`rem_n',`kh_md',`kh_se',`wald_cil',`wald_ciu',`wald_p',`kh_cil
> ',`kh_ciu',`kh_p',`t2',`i2',`dfbetas'"' _n
 39.     restore
 40. }
